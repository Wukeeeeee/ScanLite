<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 仅用于扫描成功的震动反馈 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 仅用于扫码后一键连接 Wi-Fi -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- 移除第三方库（ML Kit）间接引入的网络权限，本 App 只使用相机 -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!-- Android 11+ 包可见性：声明可能的外跳目标，便于判断是否存在处理应用 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>

        <!-- 关键：Android 11+ 必须显式声明要用到的包，否则
             PackageManager.getLaunchIntentForPackage / getPackageInfo 一律返回 null / 抛异常，
             「打开微信」这类按钮就会静默失效。 -->
        <package android:name="com.tencent.mm" />
        <package android:name="com.eg.android.AlipayGphone" />
        <package android:name="com.tencent.mobileqq" />
        <package android:name="com.sankuai.meituan" />
        <package android:name="com.taobao.taobao" />
        <package android:name="com.jingdong.app.mall" />
        <package android:name="com.xunmeng.pinduoduo" />
        <package android:name="com.ss.android.ugc.aweme" />
        <package android:name="com.xingin.xhs" />
        <package android:name="tv.danmaku.bili" />
        <package android:name="com.sina.weibo" />

        <!-- 浏览器：国产 ROM 会在查询层隐藏非默认浏览器，这里显式声明保证能被列出/直启 -->
        <package android:name="com.microsoft.emmx" />
        <package android:name="com.android.chrome" />
        <package android:name="com.quark.browser" />
        <package android:name="com.UCMobile" />
        <package android:name="com.tencent.mtt" />
        <package android:name="org.mozilla.firefox" />
        <package android:name="com.heytap.browser" />
        <package android:name="com.android.browser" />
        <package android:name="com.baidu.searchbox" />
        <package android:name="com.sec.android.app.sbrowser" />
        <package android:name="com.opera.browser" />
        <package android:name="mark.via" />
        <package android:name="com.vivo.browser" />
        <package android:name="com.miui.browser" />
    </queries>


    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.QrScan">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
